TestResults/
[Tt]est[Rr]esult*/
*.trx
coverage*.xml
*.coverage

# Logs
*.log

# Segredos e configurações locais (connection strings, senhas)
appsettings.Development.json
appsettings.Local.json
secrets.json
.env
.env.*

# Banco de dados local
*.mdf
*.ldf
*.sqlite
*.sqlite3
*.db

# Rider / JetBrains
.idea/

# VS Code
.vscode/

# ReSharper
_ReSharper*/
