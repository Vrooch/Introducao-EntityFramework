.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user
*.rsuser

# Pastas de build
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/

# Arquivos gerados pelo build
*.dll
*.exe
*.pdb
*.cache
*.nuget.g.props
*.nuget.g.targets
project.assets.json
project.lock.json

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

